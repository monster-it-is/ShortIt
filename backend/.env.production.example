# Copy these keys into the Render Web Service environment.
# Never commit real values. Render injects PORT — do not set it yourself.

NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=1

# Atlas M0 SRV URI. URL-encode special characters in the password.
# Example shape only — replace host, user, password, and database name.
MONGODB_URI=mongodb+srv://shortit_app:PASSWORD@cluster0.xxxxx.mongodb.net/shortit?retryWrites=true&w=majority

# At least 32 characters. Prefer Render's generated value.
JWT_SECRET=replace_with_at_least_32_character_secret

# Exact HTTPS origin of the Render Static Site (no trailing slash).
CORS_ORIGIN=https://shortit-web.onrender.com

# Optional overrides. Production defaults are already conservative.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_SIGNUP_MAX=5
# RATE_LIMIT_RESOLVE_MAX=120
